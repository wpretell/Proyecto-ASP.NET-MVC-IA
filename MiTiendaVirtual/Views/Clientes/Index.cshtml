@model IEnumerable<MiTiendaVirtual.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-people"></i>Clientes</h1>
        <p class="page-sub">Personas que realizan pedidos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo cliente</a>
</div>

<div class="card panel">
    <div class="card-body">
        <table class="table table-hover align-middle grid w-100">
            <thead>
                <tr>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>DNI</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Dirección</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombres</td>
                        <td>@item.Apellidos</td>
                        <td>@item.Dni</td>
                        <td>@item.Telefono</td>
                        <td>@item.Correo</td>
                        <td>@item.Direccion</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-nombre="@item.Nombres @item.Apellidos">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
