@model PedidoViewModel
@{
    ViewData["Title"] = "Nuevo pedido";
}

<div class="page-head">
    <h1 class="page-title"><i class="bi bi-receipt"></i>Nuevo pedido</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver a la lista</a>
</div>

<form asp-action="Create" id="pedidoForm">
    <partial name="_PedidoCampos" model="Model" />
</form>

@section Scripts {
    <script src="~/js/pedido.js" asp-append-version="true"></script>
}
