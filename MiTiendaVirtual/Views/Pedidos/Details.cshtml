@model Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-receipt"></i>Pedido #@Model.Id</h1>
        <p class="page-sub">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver a la lista</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Editar pedido</a>
    </div>
</div>

<div class="card panel">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="fact-label">Cliente</div>
                <div>@(Model.Cliente?.Nombres) @(Model.Cliente?.Apellidos)</div>
                <div class="text-muted small">DNI @(Model.Cliente?.Dni)</div>
            </div>
            <div class="col-md-4">
                <div class="fact-label">Tarjeta</div>
                <div>@(Model.Tarjeta?.Marca) @Formato.Ocultar(Model.Tarjeta?.Numero)</div>
            </div>
            <div class="col-md-4">
                <div class="fact-label">Estado</div>
                <span class="badge @Formato.ClaseEstado(Model.Estado)">@Model.Estado</span>
            </div>
        </div>
    </div>
</div>

<div class="card panel mt-3">
    <div class="card-body">
        <h2 class="section-title">Detalle del pedido</h2>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@(d.Producto?.Nombre)</td>
                            <td class="text-end">@d.Cantidad</td>
                            <td class="text-end">@d.PrecioUnitario.ToString("N2")</td>
                            <td class="text-end">@d.SubTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total del pedido</th>
                        <th class="text-end total-pedido">@Model.Total.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
