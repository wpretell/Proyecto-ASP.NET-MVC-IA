@{
    ViewData["Title"] = "Error";
}

<div class="page-head">
    <h1 class="page-title"><i class="bi bi-exclamation-triangle"></i>No se pudo completar la operación</h1>
</div>

<div class="card panel">
    <div class="card-body">
        <p>Vuelva a intentarlo. Si el problema continúa, avise al administrador del sistema.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ir al inicio</a>
    </div>
</div>
