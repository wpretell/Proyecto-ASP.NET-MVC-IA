@model IEnumerable<MiTiendaVirtual.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-diagram-3"></i>Categorías</h1>
        <p class="page-sub">Categorías para clasificar los productos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva categoría</a>
</div>

<div class="card panel">
    <div class="card-body">
        <table class="table table-hover align-middle grid w-100">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Activo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td><span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">@(item.Activo ? "Sí" : "No")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-nombre="@item.Nombre">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
