@model IEnumerable<MiTiendaVirtual.Models.Tarjeta>
@{
    ViewData["Title"] = "Tarjetas";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-credit-card"></i>Tarjetas</h1>
        <p class="page-sub">Tarjetas con las que se pagan los pedidos. En la lista solo se ven los últimos 4 dígitos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva tarjeta</a>
</div>

<div class="card panel">
    <div class="card-body">
        <table class="table table-hover align-middle grid w-100">
            <thead>
                <tr>
                    <th>Marca</th>
                    <th>Número</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Marca</td>
                        <td>@Formato.Ocultar(item.Numero)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-nombre="@Formato.Ocultar(item.Numero)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
