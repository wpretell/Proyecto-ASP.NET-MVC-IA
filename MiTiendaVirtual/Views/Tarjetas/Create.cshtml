@model MiTiendaVirtual.Models.Tarjeta
@{
    ViewData["Title"] = "Nueva tarjeta";
    var marcasTarjeta = new SelectList(new[] { "Visa", "Mastercard", "American Express", "Diners Club" });
}

<div class="page-head">
    <h1 class="page-title"><i class="bi bi-credit-card"></i>Nueva tarjeta</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver a la lista</a>
</div>

<div class="card panel form-panel">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Marca" class="form-label"></label>
                    <select asp-for="Marca" asp-items="marcasTarjeta" class="form-select"><option value="">-- Seleccione --</option></select>
                    <span asp-validation-for="Marca" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Numero" class="form-label"></label>
                    <input asp-for="Numero" class="form-control" inputmode="numeric" maxlength="19" autocomplete="off" />
                    <span asp-validation-for="Numero" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
