@model MiTiendaVirtual.Models.Producto
@{
    ViewData["Title"] = "Editar producto";
}

<div class="page-head">
    <h1 class="page-title"><i class="bi bi-box-seam"></i>Editar producto</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver a la lista</a>
</div>

<div class="card panel form-panel">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IdCategoria" class="form-label"></label>
                    <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select"><option value="">-- Seleccione --</option></select>
                    <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdMarca" class="form-label"></label>
                    <select asp-for="IdMarca" asp-items="ViewBag.Marcas" class="form-select"><option value="">-- Seleccione --</option></select>
                    <span asp-validation-for="IdMarca" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label"></label>
                    <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Url" class="form-label"></label>
                    <input asp-for="Url" class="form-control" />
                    <span asp-validation-for="Url" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch switch-row">
                        <input asp-for="Destacado" class="form-check-input" role="switch" />
                        <label asp-for="Destacado" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch switch-row">
                        <input asp-for="Activo" class="form-check-input" role="switch" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
